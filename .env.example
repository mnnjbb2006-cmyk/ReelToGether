# Local development defaults. In PaaS, configure these in the service dashboard.
# Mount the PaaS persistent volume at /data, then set DATA_DIR=/data.
DATA_DIR=/data
COOKIE_SECURE=true

# Optional: leave DATABASE_URL unset to use SQLite in DATA_DIR/reeltogether.db.
# If later moving to PostgreSQL, set DATABASE_URL to the provider connection string.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/reeltogether

# Optional TURN server for WebRTC voice on restrictive networks.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
