# SQLite is used by default. Override this for a production database if desired.
# Keep the data directory persistent when deploying with Docker.
DATABASE_URL=sqlite:///./data/reeltogether.db

# Set true when the application is served over HTTPS in production.
COOKIE_SECURE=false

# Optional TURN server for WebRTC voice on restrictive networks.
# Comma-separated URLs, e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
